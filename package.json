{
  "name": "taskloops",
  "version": "0.3.0",
  "description": "An Obsidian plugin that collects #task lines into a sidebar GTD inbox and closes open loops.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "node test/run.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "gtd",
    "tasks",
    "productivity"
  ],
  "author": "Sahand Poursadeghi Khiavi",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "0.20.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.65.0"
  }
}
