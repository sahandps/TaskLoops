{
  "name": "taskloops",
  "version": "0.5.4",
  "description": "Plan Markdown tasks with calendars, resource timelines and Gantt charts. Set deadlines, resize date spans, and manage tasks and subtasks by note.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "node test/run.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"preview/*.{mjs,html,css}\" \"scripts/*.mjs\" esbuild.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"preview/*.{mjs,html,css}\" \"scripts/*.mjs\" esbuild.config.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "calendar",
    "task-planner",
    "tasks",
    "projects",
    "subtasks",
    "productivity"
  ],
  "author": "Sahand Poursadeghi Khiavi",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^20.11.0",
    "esbuild": "0.20.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@event-calendar/core": "5.17.2",
    "frappe-gantt": "1.2.2"
  }
}
