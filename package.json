{
  "name": "taskloops",
  "version": "0.4.5",
  "description": "Plan Markdown tasks in calendars or a note grid. Schedule from buttons beside tasks in your notes, resize panels, and open the planner in a main tab on mobile.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "node test/run.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "calendar",
    "task-planner",
    "tasks",
    "projects",
    "subtasks",
    "productivity"
  ],
  "author": "Sahand Poursadeghi Khiavi",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^20.11.0",
    "esbuild": "0.20.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.65.0"
  }
}
